{
  "name": "Pixel Office",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "forwardPorts": [8000, 8001],
  "portsAttributes": {
    "8000": {
      "label": "Pixel Office web",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "Pixel Office web",
      "onAutoForward": "notify"
    }    
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && npm install -g @anthropic-ai/claude-code",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "Anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "vscode"
}
